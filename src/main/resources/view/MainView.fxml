<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane prefHeight="640.0" prefWidth="980.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #1e293b;">
            <padding>
                <Insets bottom="14.0" left="20.0" right="20.0" top="14.0"/>
            </padding>
            <Label text="Locadora de Filmes — Sistema "
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Clientes">
                <fx:include source="ClientesView.fxml"/>
            </Tab>
            <Tab text="Catálogo de Filmes">
                <StackPane>
                    <Label text="Em Breve"
                           style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                </StackPane>
            </Tab>
            <Tab text="Locações e Devoluções">
                <StackPane>
                    <Label text="Em Breve"
                           style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                </StackPane>
            </Tab>
        </TabPane>
    </center>

</BorderPane>